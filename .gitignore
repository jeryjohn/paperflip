# For Flutter packages/libraries, the root pubspec.lock is typically not tracked.
# The example app pubspec.lock can be tracked or ignored.
/pubspec.lock

# Symbolication & Obfuscation
app.*.symbols
app.*.map.json

# ------------------------------------------------------------------------------
# FVM (Flutter Version Management)
# ------------------------------------------------------------------------------
# Ignore SDK binaries and cache, but track .fvm/fvm_config.json
.fvm/flutter_sdk
.fvm/versions/
.fvm/release
.fvm/version

